@{
    ViewData["Title"] = "Вход";
}

<section class="next-auth-page">
    <div class="container">
        <div class="next-auth-card">
            <div class="section-kicker orange">Добро пожаловать обратно</div>
            <h1>Вход в Qazaq Quest</h1>
            <p>Войди в аккаунт и продолжи проходить городские маршруты по Астане.</p>

            <form method="post" asp-controller="Auth" asp-action="Login" class="next-auth-form">
                <div class="field">
                    <label>Email</label>
                    <input type="email" name="email" placeholder="you@example.com" required>
                </div>

                <div class="field">
                    <label>Пароль</label>
                    <input type="password" name="password" placeholder="••••••••" required>
                </div>

                <button class="btn btn-primary auth-submit" type="submit">Войти</button>
            </form>

            <div class="auth-links next-auth-links">
                <a asp-controller="Auth" asp-action="Register">Нет аккаунта? Зарегистрироваться</a>
                <a asp-controller="Home" asp-action="Index">Вернуться на главную</a>
            </div>
        </div>
    </div>
</section>
