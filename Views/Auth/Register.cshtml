@{
    ViewData["Title"] = "Регистрация";
}

<section class="next-auth-page">
    <div class="container">
        <div class="next-auth-card">
            <div class="section-kicker orange">Создай аккаунт</div>
            <h1>Регистрация</h1>
            <p>После регистрации можно участвовать в квестах, сохранять прогресс и открывать новые маршруты.</p>

            <form method="post" asp-controller="Auth" asp-action="Register" class="next-auth-form">
                <div class="field">
                    <label>Имя пользователя</label>
                    <input type="text" name="name" placeholder="Aldiyar_01" minlength="3" maxlength="30" required>
                    <small class="field-hint">Имя должно быть уникальным.</small>
                </div>

                <div class="field">
                    <label>Email</label>
                    <input type="email" name="email" placeholder="you@example.com" required>
                    <small class="field-hint">Один email — один аккаунт.</small>
                </div>

                <div class="field">
                    <label>Пароль</label>
                    <input type="password" name="password" placeholder="Минимум 8 символов" required>
                    <small class="field-hint">8–20 символов, верхний и нижний регистр, цифра и спецсимвол.</small>
                </div>

                <div class="field">
                    <label>Подтверждение пароля</label>
                    <input type="password" name="confirmPassword" placeholder="Повтори пароль" required>
                </div>

                <button class="btn btn-primary auth-submit" type="submit">Зарегистрироваться</button>
            </form>

            <div class="auth-links next-auth-links">
                <a asp-controller="Auth" asp-action="Login">Уже есть аккаунт? Войти</a>
                <a asp-controller="Home" asp-action="Index">Вернуться на главную</a>
            </div>
        </div>
    </div>
</section>
