@model QazaqQuest.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin";
}

<section class="container section-space admin-space">
    <div class="section-head">
        <div>
            <div class="eyebrow">Панель администратора</div>
            <h1>Управление квестами</h1>
            <p class="muted">Здесь можно управлять контентом, видеть активность игроков, скрытые маршруты и лидерборд.</p>
        </div>
        <div class="card-actions"><a class="btn btn-primary" asp-action="CreateQuest">Добавить квест</a></div>
    </div>

    <div class="admin-stats-grid">
        <div class="stat-card"><div class="stat-label">Квестов</div><div class="stat-value">@Model.Quests.Count</div></div>
        <div class="stat-card"><div class="stat-label">Городов</div><div class="stat-value">@Model.TotalCities</div></div>
        <div class="stat-card"><div class="stat-label">Точек</div><div class="stat-value">@Model.TotalPoints</div></div>
        <div class="stat-card"><div class="stat-label">Локаций</div><div class="stat-value">@Model.TotalLocations</div></div>
        <div class="stat-card"><div class="stat-label">Игроков</div><div class="stat-value">@Model.TotalUsers</div></div>
        <div class="stat-card"><div class="stat-label">Финишей</div><div class="stat-value">@Model.CompletedRuns</div></div>
        <div class="stat-card"><div class="stat-label">Активных прохождений</div><div class="stat-value">@Model.ActiveRuns</div></div>
        <div class="stat-card"><div class="stat-label">Скрытых квестов</div><div class="stat-value">@Model.HiddenQuests</div></div>
    </div>

    <div class="details-grid lower">
        <div class="panel admin-panel-block">
            <div class="table-scroll">
                <table class="admin-table">
                    <thead>
                        <tr><th>ID</th><th>Квест</th><th>Город</th><th>Тип</th><th>Сложность</th><th>Уровень</th><th>Особенности</th><th>Действия</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var quest in Model.Quests)
                    {
                        <tr>
                            <td>@quest.Id</td><td>@quest.Title</td><td>@quest.City</td><td>@quest.Type</td><td>@quest.Difficulty</td><td>@quest.UnlockLevel</td>
                            <td>@(quest.IsHidden ? "Скрытый " : "") @(quest.IsTimed ? "Таймер " : "") @(quest.IsCoop ? "Кооп" : "")</td>
                            <td>
                                <div class="card-actions">
                                    <a class="btn btn-ghost compact" asp-action="EditQuest" asp-route-id="@quest.Id">Редактировать</a>
                                    <form method="post" asp-action="DeleteQuest" asp-route-id="@quest.Id" onsubmit="return confirm('Удалить квест?');"><button class="btn btn-ghost compact" type="submit">Удалить</button></form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="panel">
            <h2>Топ игроков</h2>
            <div class="completed-list">
                @foreach (var user in Model.TopUsers)
                {
                    <div class="completed-item">🏆 @user.Name — lvl @user.Level · @user.ExperiencePoints XP · @user.Coins монет</div>
                }
            </div>
        </div>
    </div>
</section>
